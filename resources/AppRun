#!/usr/bin/env bash
HERE="$(dirname "$(readlink -f "$0")")"

# Dentro do AppImage o binário fica em usr/bin/, junto deste script na raiz do AppDir.
BIN="$HERE/usr/bin/OrganizadorArquivos"

# Executando diretamente do repositório (para testes), usa o build local em dist/.
if [ ! -x "$BIN" ] && [ -x "$HERE/../dist/OrganizadorArquivos" ]; then
    BIN="$HERE/../dist/OrganizadorArquivos"
fi

if [ -x "$BIN" ]; then
    exec "$BIN" "$@"
fi

# Sem binário compilado: roda o código-fonte diretamente.
if [ -f "$HERE/../main.py" ]; then
    cd "$HERE/.." || exit 1
    exec python3 main.py "$@"
fi

echo "Nem o binário (usr/bin/OrganizadorArquivos ou dist/OrganizadorArquivos) nem main.py foram encontrados." >&2
exit 1
